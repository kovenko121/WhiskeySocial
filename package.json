{
  "name": "whiskeysocial",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "ts:check": "tsc && cd cms && tsc --noEmit",
    "ts:check:app": "tsc",
    "ts:check:cms": "cd cms && tsc --noEmit",
    "test:ci": "jest --ci",
    "lint": "NODE_OPTIONS=--max-old-space-size=12288 yarn eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=12288 yarn eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules && rm -rf ios/Pods && rm -rf ios/Podfile.lock && rm -rf android/build",
    "build": "yarn install && cd ios && pod install && cd .. && yarn react-native run-ios",
    "seed:tasting-event": "ts-node --project scripts/tsconfig.json scripts/seed-tasting-event.ts",
    "sync-app-version": "ts-node --project scripts/tsconfig.json scripts/sync-app-version.ts",
    "sync-app-version:execute": "ts-node --project scripts/tsconfig.json scripts/sync-app-version.ts --execute",
    "deploy:scripts": "ts-node --project scripts/tsconfig.json scripts/deployment/run-deployment-scripts.ts",
    "deploy:scripts:dry-run": "ts-node --project scripts/tsconfig.json scripts/deployment/run-deployment-scripts.ts --dry-run",
    "deploy:validate": "ts-node --project scripts/tsconfig.json scripts/deployment/run-deployment-scripts.ts --validate",
    "export-newsletter-users": "ts-node --project scripts/tsconfig.json scripts/export-newsletter-users.ts",
    "export-newsletter-users:prod": "ts-node --project scripts/tsconfig.json scripts/export-newsletter-users.ts --prod",
    "cms": "cd cms && yarn dev",
    "cms:install": "cd cms && yarn install",
    "cms:build": "cd cms && yarn build",
    "update:staging": "bash scripts/eas-update.sh staging all",
    "update:production": "bash scripts/eas-update.sh production all"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.|@expo-google-fonts/.|react-navigation|@react-navigation/.|@unimodules/.|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@aws-amplify/auth": "^5.3.7",
